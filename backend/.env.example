WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
INSTAGRAM_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_APP_ID=
# Instagram Graph API sürümü. Meta bir sürümü kaldırırsa deploy'suz burayı güncelle (ör. v21.0).
INSTAGRAM_GRAPH_VERSION=v21.0
WEBHOOK_VERIFY_TOKEN=
# Webhook imza doğrulamasını AKTİF eder. Webhook'u alan Meta app'inin App Secret'ı.
# Boş bırakılırsa doğrulama atlanır (mevcut davranış). IG + WhatsApp aynı app ise tek secret yeterli.
# (INSTAGRAM_APP_SECRET yukarıda da var.)
# Kendi Instagram/Sayfa hesap ID'miz (giden/gelen ayrımı). Boşsa varsayılan kullanılır.
INSTAGRAM_PAGE_ID=17841401244343060
# sync-conversations kesim tarihi (YYYY-MM-DD): öncesi atlanır.
SYNC_CUTOFF_DATE=2026-05-15
# CORS: izinli origin'ler (virgülle ayrık, ör. https://app.alanadin.com). Boşsa "*".
ALLOWED_ORIGINS=
DATABASE_URL=
# Geliştirici/Sistem Sağlığı panelini yalnızca bu kullanıcı adına sahip hesaba açar
# (admin bile değil). Boşsa panele kimse erişemez. Uygulamayı satarken alıcıya verme.
OWNER_USERNAME=
# Meta reklam analizi (ads_read izinli system-user/business token)
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# İzlenecek reklam hesapları: act_id|isim|amaç  (amaç: wix_kayit|ig_dm|wa_dm|genel)
# Örn: META_AD_ACCOUNTS=act_123|Wix Kayıt|wix_kayit, act_456|WhatsApp & IG DM|wa_dm
# Boş bırakılırsa token'dan otomatik keşfedilir.
META_AD_ACCOUNTS=
# Otomatik seminer e-postası (Gmail SMTP).
# ARTIK uygulama içinden yönetilir: Parametreler → Mail Ayarları (DB'de şifreli saklanır).
# Aşağıdaki env'ler yalnızca OPSİYONEL YEDEKTİR — DB'de ayar yoksa bunlar kullanılır.
# SMTP_PASSWORD = Gmail 16 haneli "Uygulama Şifresi" (hesapta 2 Adımlı Doğrulama açık olmalı).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=